{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coverage Category frontmatter",
  "type": "object",
  "required": [
    "artifact_type",
    "document_type",
    "category_id",
    "category",
    "coverage_model_version",
    "coverage_model_hash",
    "coverage_dimensions",
    "category_score",
    "status",
    "confidence",
    "validation"
  ],
  "properties": {
    "coverage_model_version": {"type": "string", "minLength": 1},
    "coverage_model_hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "coverage_dimensions": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {"type": "number", "enum": [0, 0.25, 0.5, 0.75, 1]},
          {"type": "null"}
        ]
      }
    },
    "category_score": {"type": "integer", "minimum": 0, "maximum": 100}
  }
}
