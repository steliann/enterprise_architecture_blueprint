{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture Recommendation frontmatter",
  "type": "object",
  "required": ["id", "title", "artifact_type", "status", "confidence", "validation", "state", "originating_gaps"],
  "properties": {
    "id": {"type": "string", "pattern": "^REC-[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 3},
    "artifact_type": {"const": "Architecture Recommendation"},
    "status": {"enum": ["current", "planned", "target", "transitional", "deprecated", "retired"]},
    "confidence": {"enum": ["high", "medium", "low", "not_assessed"]},
    "validation": {"enum": ["confirmed", "needs_correction", "incomplete", "unable_to_validate", "not_applicable"]},
    "state": {"enum": ["proposed", "accepted", "planned", "in_progress", "implemented", "validated", "completed", "rejected", "deferred", "superseded"]},
    "originating_gaps": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^GAP-[0-9]{3,}$"}}
  }
}
