{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "business-use-case",
  "type": "object",
  "required": [
    "type",
    "artifact_type",
    "schema_version",
    "id",
    "title",
    "status",
    "confidence",
    "business_area",
    "purpose_summary",
    "business_question",
    "related_required_capabilities",
    "related_data_products",
    "known_consumers",
    "created_on",
    "last_updated"
  ],
  "properties": {
    "type": {
      "const": "business-use-case"
    },
    "artifact_type": {
      "const": "Business Use Case"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "pattern": "^UC-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "business_area": {
      "type": "string"
    },
    "purpose_summary": {
      "type": "string",
      "minLength": 1
    },
    "business_question": {
      "type": "string",
      "minLength": 1
    },
    "related_required_capabilities": {
      "type": "array",
      "items": {
        "pattern": "^RC-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "related_data_products": {
      "type": "array",
      "items": {
        "pattern": "^DP-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "known_consumers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "created_on": {
      "$ref": "#/$defs/date"
    },
    "last_updated": {
      "$ref": "#/$defs/date"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "idList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(UC|RC|DP|DF|QC|OC|ADR)-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "Confirmed",
        "Candidate",
        "Target",
        "Transitional",
        "Deprecated",
        "Superseded"
      ]
    },
    "confidence": {
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
