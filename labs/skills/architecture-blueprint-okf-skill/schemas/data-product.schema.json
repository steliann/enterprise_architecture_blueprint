{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data-product",
  "type": "object",
  "required": [
    "type",
    "artifact_type",
    "schema_version",
    "id",
    "title",
    "status",
    "confidence",
    "supports_use_cases",
    "provides_required_capabilities",
    "produced_or_updated_by",
    "assured_by_quality_controls",
    "operated_by_capabilities",
    "shaped_by_adrs",
    "created_on",
    "last_updated"
  ],
  "properties": {
    "type": {
      "const": "data-product"
    },
    "artifact_type": {
      "const": "Data Product"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "pattern": "^DP-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "supports_use_cases": {
      "type": "array",
      "items": {
        "pattern": "^UC-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "provides_required_capabilities": {
      "type": "array",
      "items": {
        "pattern": "^RC-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "produced_or_updated_by": {
      "type": "array",
      "items": {
        "pattern": "^DF-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "assured_by_quality_controls": {
      "type": "array",
      "items": {
        "pattern": "^QC-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "operated_by_capabilities": {
      "type": "array",
      "items": {
        "pattern": "^OC-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "shaped_by_adrs": {
      "type": "array",
      "items": {
        "pattern": "^ADR-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "created_on": {
      "$ref": "#/$defs/date"
    },
    "last_updated": {
      "$ref": "#/$defs/date"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "idList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(UC|RC|DP|DF|QC|OC|ADR)-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "Confirmed",
        "Candidate",
        "Target",
        "Transitional",
        "Deprecated",
        "Superseded"
      ]
    },
    "confidence": {
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
